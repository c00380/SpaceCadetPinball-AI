 		break;
 	}
 }
+
+
+void control::GetAiInfo(int& mission, int& missionReady, int& fuel, int& shootAgain, int& ballSave)
+{
+	mission = missionReady = fuel = shootAgain = ballSave = 0;
+	if (!lite198)
+		return;
+	mission = lite198->MessageField;
+	missionReady = lite56 && lite56->light_on() ? 1 : 0;
+	fuel = fuel_bargraph ? fuel_bargraph->Message(MessageCode::TLightGroupGetOnCount, 0.0) : 0;
+	shootAgain = lite199 && lite199->light_on() ? 1 : 0;
+	ballSave = lite200 && lite200->light_on() ? 1 : 0;
+}
+
+
+void control::GetAiLanes(float* out, int count)
+{
+	for (int i = 0; i < count; i++)
+		out[i] = 0;
+	if (!bmpr_inc_lights || !ramp_bmpr_inc_lights)
+		return;
+	int n = 0;
+	auto put = [&](bool on)
+	{
+		if (n < count)
+			out[n] = on ? 1.0f : 0.0f;
+		n++;
+	};
+	for (int i = 0; i < 4; i++)
+		put(i < static_cast<int>(bmpr_inc_lights->List.size()) && bmpr_inc_lights->List[i]->light_on());
+	for (int i = 0; i < 4; i++)
+		put(i < static_cast<int>(ramp_bmpr_inc_lights->List.size()) && ramp_bmpr_inc_lights->List[i]->light_on());
+	TLight* others[] = {lite169, lite170, lite171, lite17, lite18, lite27, lite28, lite29, lite30};
+	for (auto light : others)
+		put(light && light->light_on());
+}
