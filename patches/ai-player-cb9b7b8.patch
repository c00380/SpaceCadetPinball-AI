+	// Todo: remove original clear, if save for all platforms
+	SDL_RenderFillRect(Renderer, nullptr);
+	render::PresentVScreen();
+
+	ImGui::Render();
+	ImGui_Render_RenderDrawData(ImGui::GetDrawData());
+
+	SDL_RenderPresent(Renderer);
+}
+
+void winmain::AiLoop(int port)
+{
+	if (!ai::Init(port))
+	{
+		printf("[ai] could not open the socket\n");
+		return;
+	}
+	bQuit = false;
+	single_step = false;
+	const auto frameTime = DurationMs(ai::FrameMs);
+	auto deadline = Clock::now();
+	unsigned frameNo = 0;
+
+	auto pump = [&]()
+	{
+		SDL_Event event;
+		while (SDL_PollEvent(&event))
+		{
+			if (!event_handler(&event))
+				bQuit = true;
+		}
+	};
+
+	ai::Command cmd{};
+	while (!bQuit && ai::ReadCommand(cmd))
+	{
+		if (cmd.Type == 'Q')
+			break;
+		if (cmd.Type == 'R')
+		{
+			ai::NewGame();
+			deadline = Clock::now();
+		}
+		else if (cmd.Type == 'S')
+		{
+			ai::SetFlippers(cmd.Left, cmd.Right);
+			for (int i = 0; i < cmd.Frames && !bQuit; i++)
+			{
+				pb::frame(ai::FrameMs);
+				ai::AfterFrame();
+				if (!ai::Headless)
+				{
+					pump();
+					if (++frameNo % 2 == 0)
+						RenderFrame();
+					deadline += std::chrono::duration_cast<Clock::duration>(frameTime);
+					auto now = Clock::now();
+					if (deadline > now)
+						HybridSleep(DurationMs(deadline - now));
+					else if (now - deadline > std::chrono::duration_cast<Clock::duration>(frameTime * 10))
+						deadline = now;
+				}
+			}
+		}
+		ai::Send(ai::Observation());
+	}
+	ai::Shutdown();
+}
