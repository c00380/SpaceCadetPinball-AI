diff --git a/SpaceCadetPinball/ai_bridge.cpp b/SpaceCadetPinball/ai_bridge.cpp
new file mode 100644
index 0000000..a5c493e
--- /dev/null
+++ b/SpaceCadetPinball/ai_bridge.cpp
@@ -0,0 +1,335 @@
+#include "pch.h"
+#include "ai_bridge.h"
+
+#include <random>
+
+#ifdef _WIN32
+#define NOMINMAX
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using sock_t = SOCKET;
+#else
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <unistd.h>
+using sock_t = int;
+#define INVALID_SOCKET (-1)
+#define closesocket close
+#endif
+
+#include "control.h"
+#include "pb.h"
+#include "TBall.h"
+#include "TFlipper.h"
+#include "TFlipperEdge.h"
+#include "TPinballTable.h"
+#include "TPlunger.h"
+
+namespace ai
+{
+	bool Enabled = false;
+	bool Headless = false;
+
+	namespace
+	{
+		constexpr int MaxBallSlots = 3;
+		constexpr int LaneCount = 17;
+		constexpr float LaunchDelay = 0.6f;
+		constexpr float LaunchCooldown = 1.5f;
+		constexpr float HitDebounce = 0.25f;
+
+		struct Field
+		{
+			const char* Name;
+			double Value;
+		};
+
+		sock_t Client = INVALID_SOCKET;
+		std::string RecvBuf;
+		std::mt19937 Rng{std::random_device{}()};
+
+		bool LeftOn = false, RightOn = false;
+		int HitsActive[2]{}, HitsPassive[2]{};
+		float LastHitTime[2][2]{};
+		int Launches = 0, Drains = 0;
+		int PrevBallCount = 0;
+		float PlungerWait = 0, SinceLaunch = LaunchCooldown;
+		float GameTime = 0;
+
+		TBall* BallInPlungerLane()
+		{
+			auto table = pb::MainTable;
+			for (auto ball : table->BallList)
+			{
+				if (!ball->ActiveFlag)
+					continue;
+				auto dy = ball->Position.Y - table->PlungerPosition.Y;
+				if (std::fabs(ball->Position.X - table->PlungerPosition.X) < 0.8f &&
+					dy > -1.0f && dy < 3.0f && ball->Speed < 0.8f)
+					return ball;
+			}
+			return nullptr;
+		}
+
+		std::vector<Field> CollectFields()
+		{
+			auto table = pb::MainTable;
+			std::vector<Field> f;
+			auto add = [&f](const char* name, double value) { f.push_back({name, value}); };
+
+			int mission, missionReady, fuel, shootAgain, ballSave;
+			control::GetAiInfo(mission, missionReady, fuel, shootAgain, ballSave);
+			auto angle = [](const TFlipperEdge* e) { return e->AngleMax != 0 ? e->CurrentAngle / e->AngleMax : 0.0f; };
+			auto leftEdge = table->FlipperL->FlipperEdge, rightEdge = table->FlipperR->FlipperEdge;
+
+			add("score", table->CurScore + static_cast<double>(table->CurScoreE9) * 1e9);
+			add("game_over", pb::game_mode == GameModes::GameOver);
+			add("ball_count", table->BallCount);
+			add("extra_balls", table->ExtraBalls);
+			add("multiball", table->MultiballCount);
+			add("tilt", table->TiltLockFlag);
+			add("score_mult", table->ScoreMultiplier);
+			add("mission", mission);
+			add("mission_ready", missionReady);
+			add("fuel", fuel);
+			add("shoot_again", shootAgain);
+			add("ball_save", ballSave);
+			add("time", GameTime);
+			add("lflip_angle", angle(leftEdge));
+			add("lflip_active", LeftOn);
+			add("rflip_angle", angle(rightEdge));
+			add("rflip_active", RightOn);
+			add("lflip_px", leftEdge->RotOrigin.X);
+			add("lflip_py", leftEdge->RotOrigin.Y);
+			add("rflip_px", rightEdge->RotOrigin.X);
+			add("rflip_py", rightEdge->RotOrigin.Y);
+			add("hits_l_act", HitsActive[0]);
+			add("hits_r_act", HitsActive[1]);
+			add("hits_l_pas", HitsPassive[0]);
+			add("hits_r_pas", HitsPassive[1]);
+			add("drains", Drains);
+			add("launches", Launches);
+			add("plunger_ready", BallInPlungerLane() != nullptr);
+
+			std::vector<TBall*> balls;
+			for (auto ball : table->BallList)
+				if (ball->ActiveFlag)
+					balls.push_back(ball);
+			std::sort(balls.begin(), balls.end(), [](const TBall* a, const TBall* b) { return a->Position.Y > b->Position.Y; });
+			add("n_balls", static_cast<double>(balls.size()));
+			static const char* const ballNames[MaxBallSlots][5] = {
+				{"b0_act", "b0_x", "b0_y", "b0_vx", "b0_vy"},
+				{"b1_act", "b1_x", "b1_y", "b1_vx", "b1_vy"},
+				{"b2_act", "b2_x", "b2_y", "b2_vx", "b2_vy"},
+			};
+			for (int i = 0; i < MaxBallSlots; i++)
+			{
+				const bool present = i < static_cast<int>(balls.size());
+				const TBall* b = present ? balls[i] : nullptr;
+				add(ballNames[i][0], present);
+				add(ballNames[i][1], present ? b->Position.X : 0);
+				add(ballNames[i][2], present ? b->Position.Y : 0);
+				add(ballNames[i][3], present ? b->Direction.X * b->Speed : 0);
+				add(ballNames[i][4], present ? b->Direction.Y * b->Speed : 0);
+			}
+
+			static const char* const laneNames[LaneCount] = {
+				"lane0", "lane1", "lane2", "lane3", "lane4", "lane5", "lane6", "lane7", "lane8",
+				"lane9", "lane10", "lane11", "lane12", "lane13", "lane14", "lane15", "lane16"};
+			float lanes[LaneCount];
+			control::GetAiLanes(lanes, LaneCount);
+			for (int i = 0; i < LaneCount; i++)
+				add(laneNames[i], lanes[i]);
+			return f;
+		}
+	}
+
+	bool Init(int port)
+	{
+#ifdef _WIN32
+		WSADATA wsa;
+		if (WSAStartup(MAKEWORD(2, 2), &wsa) != 0)
+			return false;
+#endif
+		sock_t server = socket(AF_INET, SOCK_STREAM, 0);
+		if (server == INVALID_SOCKET)
+			return false;
+		int yes = 1;
+#ifdef _WIN32
+		setsockopt(server, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, reinterpret_cast<const char*>(&yes), sizeof yes);
+#else
+		setsockopt(server, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&yes), sizeof yes);
+#endif
+		sockaddr_in addr{};
+		addr.sin_family = AF_INET;
+		addr.sin_port = htons(static_cast<unsigned short>(port));
+		inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr);
+		if (bind(server, reinterpret_cast<sockaddr*>(&addr), sizeof addr) != 0 || listen(server, 1) != 0)
+		{
+			closesocket(server);
+			return false;
+		}
+		printf("[ai] waiting for the agent on 127.0.0.1:%d\n", port);
+		fflush(stdout);
+		Client = accept(server, nullptr, nullptr);
+		closesocket(server);
+		if (Client == INVALID_SOCKET)
+			return false;
+		setsockopt(Client, IPPROTO_TCP, TCP_NODELAY, reinterpret_cast<const char*>(&yes), sizeof yes);
+
+		std::string header = "H";
+		for (const auto& field : CollectFields())
+			header += std::string(" ") + field.Name;
+		Send(header + "\n");
+		return true;
+	}
+
+	void Shutdown()
+	{
+		if (Client != INVALID_SOCKET)
+			closesocket(Client);
+		Client = INVALID_SOCKET;
+#ifdef _WIN32
+		WSACleanup();
+#endif
+	}
+
+	void Send(const std::string& line)
+	{
+		size_t sent = 0;
+		while (Client != INVALID_SOCKET && sent < line.size())
+		{
+			auto n = send(Client, line.data() + sent, static_cast<int>(line.size() - sent), 0);
+			if (n <= 0)
+				return;
+			sent += n;
+		}
+	}
+
+	bool ReadCommand(Command& cmd)
+	{
+		while (true)
+		{
+			auto end = RecvBuf.find('\n');
+			if (end != std::string::npos)
+			{
+				auto line = RecvBuf.substr(0, end);
+				RecvBuf.erase(0, end + 1);
+				if (line.empty())
+					continue;
+				cmd = {};
+				cmd.Type = line[0];
+				if (cmd.Type == 'S')
+				{
+					int left = 0, right = 0, frames = 1;
+					sscanf(line.c_str() + 1, "%d %d %d", &left, &right, &frames);
+					cmd.Left = left != 0;
+					cmd.Right = right != 0;
+					cmd.Frames = frames > 1 ? frames : 1;
+				}
+				return true;
+			}
+			char chunk[512];
+			auto n = recv(Client, chunk, sizeof chunk, 0);
+			if (n <= 0)
+				return false;
+			RecvBuf.append(chunk, n);
+		}
+	}
+
+	void NewGame()
+	{
+		LeftOn = RightOn = false;
+		HitsActive[0] = HitsActive[1] = HitsPassive[0] = HitsPassive[1] = 0;
+		for (auto& times : LastHitTime)
+			times[0] = times[1] = -HitDebounce;
+		Launches = Drains = 0;
+		PlungerWait = 0;
+		SinceLaunch = LaunchCooldown;
+		GameTime = 0;
+		pb::replay_level(false);
+		PrevBallCount = pb::MainTable->BallCount;
+	}
+
+	void SetFlippers(bool left, bool right)
+	{
+		auto table = pb::MainTable;
+		if (pb::game_mode != GameModes::InGame)
+			left = right = false;
+		if (left != LeftOn)
+		{
+			LeftOn = left;
+			table->Message(left ? MessageCode::LeftFlipperInputPressed : MessageCode::LeftFlipperInputReleased,
+			               pb::time_now);
+		}
+		if (right != RightOn)
+		{
+			RightOn = right;
+			table->Message(right ? MessageCode::RightFlipperInputPressed : MessageCode::RightFlipperInputReleased,
+			               pb::time_now);
+		}
+	}
+
+	void AfterFrame()
+	{
+		auto table = pb::MainTable;
+		const float dt = FrameMs * 0.001f;
+		GameTime += dt;
+		SinceLaunch += dt;
+		table->CheatsUsed = 1;
+
+		if (table->BallCount < PrevBallCount)
+			Drains++;
+		PrevBallCount = table->BallCount;
+
+		const bool ready = pb::game_mode == GameModes::InGame && !table->TiltLockFlag &&
+			table->Plunger->SomeCounter == 0 && BallInPlungerLane();
+		PlungerWait = ready ? PlungerWait + dt : 0;
+		if (PlungerWait >= LaunchDelay && SinceLaunch >= LaunchCooldown)
+		{
+			std::uniform_real_distribution<float> strength(0.55f, 1.0f);
+			auto plunger = table->Plunger;
+			plunger->PullbackStartedFlag = true;
+			plunger->Boost = plunger->MaxPullback * strength(Rng);
+			plunger->Message(MessageCode::PlungerInputReleased, 0.0f);
+			Launches++;
+			PlungerWait = 0;
+			SinceLaunch = 0;
+		}
+	}
+
+	void OnFlipperHit(const TFlipperEdge* edge, bool active)
+	{
+		auto table = pb::MainTable;
+		if (!Enabled || !table)
+			return;
+		int side;
+		if (table->FlipperL && table->FlipperL->FlipperEdge == edge)
+			side = 0;
+		else if (table->FlipperR && table->FlipperR->FlipperEdge == edge)
+			side = 1;
+		else
+			return;
+
+		active = active || (side == 0 ? LeftOn : RightOn);
+		auto& lastTime = LastHitTime[side][active ? 0 : 1];
+		if (GameTime - lastTime < HitDebounce)
+			return;
+		lastTime = GameTime;
+		++(active ? HitsActive : HitsPassive)[side];
+	}
+
+	std::string Observation()
+	{
+		std::string line = "O";
+		char value[32];
+		for (const auto& field : CollectFields())
+		{
+			snprintf(value, sizeof value, " %.10g", field.Value);
+			line += value;
+		}
+		return line + "\n";
+	}
+}
